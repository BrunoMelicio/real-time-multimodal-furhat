# Copy to .env in this project folder. The app loads it automatically.
# Existing exported shell variables take precedence. .env is ignored by Git.
GROQ_API_KEY=

# Optional: make Groq your default (CLI flags take precedence).
# LLM_PROVIDER=groq
# LLM_MODEL=openai/gpt-oss-20b

# OpenAI: choose --llm=openai --llm-model=YOUR_MODEL
# OPENAI_API_KEY=

# Another OpenAI-compatible Chat Completions service:
# LLM_PROVIDER=compatible
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_MODEL=your-model-id
# LLM_API_KEY=
# Or use --llm-key-env=YOUR_KEY_VARIABLE to select another variable.
